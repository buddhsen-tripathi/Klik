{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klik",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // React app is served as static assets; only /api/* hits the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Photos and generated GLB models.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "assemble-files" }],

  // Scan records (status, Gemini analysis, model file keys).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assemble-db",
      "database_id": "bc4791e9-7ed0-45fa-acc2-39fac5314885",
      "migrations_dir": "migrations"
    }
  ],

  // One workflow instance per scan: Gemini analysis -> fal 3D job -> save GLBs.
  "workflows": [
    {
      "name": "scan-workflow",
      "binding": "SCAN_WORKFLOW",
      "class_name": "ScanWorkflow"
    }
  ],

  "vars": {
    // Two Gemini 4 models: neon for the essential reasoning, hydrogen for fast helper calls.
    // Accuracy model (neon): the planner (looks at the photos, lists parts + 2D boxes for SAM 3D) and the manual summary.
    "GEMINI_MODEL": "gemini-4-neon",
    // MINIMAL | LOW | MEDIUM | HIGH. LOW keeps analysis fast; raise it if parts/steps look sloppy.
    "ANALYSIS_THINKING": "LOW",
    // Step writers (one per subassembly, in parallel), fix plans and step rewrites: neon, for manual-level detail.
    "STEPS_MODEL": "gemini-4-neon",
    // Parallel SAM 3D jobs per scan (one per part, $0.02 each). SAM 3D takes ~25 s per box, so one job per part is fastest.
    "MAX_3D_JOBS": "10",
    // High-quality part models (Nano Banana Pro → Trellis 2, ~$0.45 each, ~60 s, in parallel), hidden parts
    // included, placed from the parts list. One process per scan: SAM 3D only runs when this is 0.
    "MAX_HQ_PARTS": "10",
    // Fast model (hydrogen) for quick, frequent or cosmetic calls: live camera naming, identify, reference images, translation.
    "IDENTIFY_MODEL": "gemini-4-hydrogen",
    // Voice agent (Gemini Live, audio in and out, tool calls). Browser connects directly with an ephemeral token.
    "LIVE_MODEL": "gemini-3.8-live"
  }
  // Secrets (set with `wrangler secret put`, or .dev.vars locally):
  //   GEMINI_API_KEY  - required
  //   FAL_KEY         - optional; without it you get the Gemini blockout model only
}
